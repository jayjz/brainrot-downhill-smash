{
  "name": "BrainrotDownhillSmash",
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Modules": {
        "$path": "src/ReplicatedStorage/Modules"
      },
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "RemoteEvents": {
        "$className": "Folder",
        "PlayerScored": {
          "$className": "RemoteEvent"
        },
        "RagdollTriggered": {
          "$className": "RemoteEvent"
        },
        "HazardHit": {
          "$className": "RemoteEvent"
        },
        "CheckpointReached": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Assets": {
        "$className": "Folder",
        "Hazards": {
          "$className": "Folder"
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      },
      "StarterCharacterScripts": {
        "$path": "src/StarterPlayer/StarterCharacterScripts"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 500,
        "StreamingMinRadius": 64
      },
      "SlopeContainer": {
        "$className": "Folder"
      },
      "Terrain": {
        "$className": "Terrain"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [
          0.7,
          0.7,
          0.7
        ],
        "Brightness": 2,
        "Technology": "Future"
      }
    }
  }
}